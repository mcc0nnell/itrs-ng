{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itrs-ng.example.invalid/schemas/asl-resource.schema.json",
  "title": "iTRS NG ASL Resource",
  "description": "Advertisement for an ASL-capable real-time communications resource.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "endpoint", "language", "media", "role", "scope", "services", "state", "authority"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "endpoint": {"type": "string", "minLength": 1},
    "language": {"const": "ASL"},
    "media": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["video", "rtt", "voice", "text"]}},
    "role": {"enum": ["telecommunicator", "interpreter", "bridge"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "jurisdiction"],
      "properties": {
        "kind": {"enum": ["local", "regional", "national"]},
        "jurisdiction": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "services": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "state": {"enum": ["available", "busy", "unavailable", "unknown"]},
    "priority": {"type": "integer"},
    "dispatch_authority": {"type": "boolean"},
    "queue": {"type": "string"},
    "organization": {"type": "string"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "version"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "valid_from": {"type": "string", "format": "date-time"},
        "valid_until": {"type": "string", "format": "date-time"}
      }
    }
  }
}
