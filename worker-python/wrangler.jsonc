{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "itrs-edge-mcp-python",
  "main": "src/entry.py",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["python_workers", "python_workers_314"],
  "services": [
    {
      "binding": "EDGE",
      "service": "itrs-edge-mcp"
    }
  ]
}
